<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music_pill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/card_surface"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/music_art_container"
        android:layout_width="44dp"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/music_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/music_art_mask"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@string/localized_085" />
        <TextView
            android:id="@+id/music_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/music_placeholder_background"
            android:gravity="center"
            android:text="♫"
            android:textColor="#FFDDEAFF"
            android:textSize="22sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/music_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFAFAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFABABB2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/music_activity"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/group_count_background"
        android:gravity="center"
        android:text="♫"
        android:textColor="#FFF1F1F4"
        android:textSize="13sp" />
</LinearLayout>
