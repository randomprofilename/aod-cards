<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_overflow_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="22dp">

    <TextView
        android:id="@+id/widget_overflow_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:minHeight="22dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="28dp"
        android:background="@drawable/overflow_badge_background"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="#FFF1F1F4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_overflow_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:minHeight="22dp"
        android:layout_gravity="center"
        android:background="@drawable/overflow_badge_background"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="#FFF1F1F4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_overflow_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:minHeight="22dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="28dp"
        android:background="@drawable/overflow_badge_background"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="#FFF1F1F4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
